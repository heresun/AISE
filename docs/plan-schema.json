{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/heresun/AISE/docs/plan-schema.json",
  "title": "AISE plan.json schema",
  "description": "机器可读约束，与 scripts/aise_run_init.py 的 validate_plan 单一事实源一致。供 aise-planning-with-files skill 内嵌，让 LLM 生成时即对照（错误前移）。只反映代码真实强制的规则——不引入 validate_plan 未强制的约束。",
  "type": "object",
  "required": ["schema_version", "task_title", "tasks"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "固定 '1.0'"
    },
    "task_title": {
      "type": "string",
      "minLength": 1,
      "description": "本次任务的总标题，非空"
    },
    "allow_disjoint_shared_evidence": {
      "type": "boolean",
      "description": "可选。true 时 shared_evidence_tasks 的 scope 不相交仅 warn，不报错"
    },
    "scope_policy": {
      "type": "object",
      "description": "可选。mtime_window_tolerance_ms 等 scope 策略",
      "properties": {
        "mtime_window_tolerance_ms": {"type": "integer", "minimum": 0}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "description": "DAG 任务列表，非空",
      "items": {
        "type": "object",
        "required": ["task_id", "title", "scope", "test_manifest"],
        "additionalProperties": true,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "description": "任务唯一 ID（如 T-001）。代码仅强制非空唯一，不强制具体格式"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "任务标题，非空"
          },
          "scope": {
            "type": "object",
            "required": ["paths"],
            "description": "本任务允许改动的范围（scope gate 用）",
            "properties": {
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1},
                "description": "glob 列表，非空，每项非空字符串"
              }
            }
          },
          "test_manifest": {
            "type": "object",
            "required": ["pipe"],
            "description": "测试清单。pipe 必须在 PIPE_DEFS 内",
            "properties": {
              "pipe": {
                "enum": [
                  "go-test-json-to-junit",
                  "mvn-surefire",
                  "pytest-junitxml",
                  "jest-junit",
                  "cargo-test-junit",
                  "cargo-nextest-junit"
                ],
                "description": "与 event_runner.PIPE_DEFS 同步——新增 pipe 务必同步本枚举"
              },
              "targets": {
                "type": "array",
                "items": {"type": "string"},
                "description": "可选。测试目标选择器（runner 各自有默认值）"
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "description": "可选。前置任务 task_id 列表，必须引用存在的 task 且无环"
          },
          "shared_evidence_tasks": {
            "type": "array",
            "items": {"type": "string"},
            "description": "可选。共享 evidence 的 task_id 列表，scope 需与本任务相交"
          }
        }
      }
    }
  }
}
